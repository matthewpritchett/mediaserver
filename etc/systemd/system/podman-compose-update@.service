[Unit]
Description=update %i
ConditionPathExists=!/vault/containers/%i/no-update
Requires=zfs.target
After=zfs.target network-online.target

[Service]
Type=oneshot
User=media
Group=media
WorkingDirectory=/vault/containers/%i
TimeoutSec=900
Environment="HOME=/vault/containers/%i"
Environment="XDG_RUNTIME_DIR=/run/user/8675309"
Environment="STORAGE_DRIVER=overlay"
Environment="STORAGE_OPTS=overlay.mount_program=/usr/bin/fuse-overlayfs"

ExecStart=+/bin/systemctl stop podman-compose@%i.service

ExecStart=/bin/bash -c "echo $(date +%%T.%%N)"

ExecStart=+/bin/bash -c 'touch no-update && chown media:media no-update && zfs snapshot -r vault/containers/%i@$(date +%%Y-%%m-%%d-%%H%%M%%S) && rm no-update'

ExecStart=/usr/local/bin/podman-compose pull

ExecStart=/usr/local/bin/podman-compose build

ExecStart=+/usr/local/bin/zfs-prune-snapshots -v 1y vault/containers/%i

ExecStart=/usr/bin/podman image prune -f

ExecStartPost=-/bin/bash -c 'cat info.txt | mail -s "%i updated" root'

ExecStopPost=+/bin/systemctl start podman-compose@%i.service
