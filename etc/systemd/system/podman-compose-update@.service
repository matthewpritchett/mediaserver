[Unit]
Description=update %i via podman-compose
ConditionPathExists=!/vault/containers/%i/no-update
Requires=zfs.target
After=zfs.target network-online.target

[Service]
Type=oneshot
User=pritchett
Group=pritchett
WorkingDirectory=/vault/containers/%i
TimeoutSec=900

# stop the service
ExecStart=+/bin/systemctl stop podman-compose@%i.service

# timestamp
ExecStart=/bin/bash -c "echo $(date +%%T.%%N)"

# create snapshot with updates disabled
ExecStart=+/bin/bash -c 'touch no-update && chown pritchett:pritchett no-update && zfs snapshot -r vault/containers/%i@$(date +%%Y-%%m-%%d-%%H%%M%%S) && rm no-update'

# build latest images
ExecStart=/usr/local/bin/podman-compose build

# save the retagged images
ExecStart=/bin/bash -c 'podman image save $(podman-compose config | awk "/^[[:space:]]*image:[[:space:]]*/ {print \$2}") | pigz --fast > images.tar.gz'

# email if updates enabled
ExecStartPost=-/bin/bash -c 'cat info.txt | mail -s "%i updated" root'

# restart the app
ExecStopPost=+/bin/systemctl start podman-compose@%i.service
