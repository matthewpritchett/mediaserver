[Unit]
Description=%i
Requires=zfs.target
After=zfs.target network-online.target

[Service]
Type=exec
User=pritchett
Group=pritchett
WorkingDirectory=/vault/containers/%i
TimeoutSec=900
Restart=on-failure
RestartSec=5s

# stop the app via podman-compose 
ExecStartPre=/usr/local/bin/podman-compose down --remove-orphans

# load local images to podman
ExecStartPre=-/usr/bin/podman image load --input images.tar.gz

# start the app via podman-compose
ExecStartPre=/usr/local/bin/podman-compose --in-pod=1 up --detach --remove-orphans --force-recreate --renew-anon-volumes --abort-on-container-failure

# wait for exit
ExecStart=/usr/local/bin/podman-compose wait

# stop the app via podman-compose 
ExecStop=/usr/local/bin/podman-compose down --remove-orphans

# timestamp
ExecStop=/bin/bash -c "echo $(date +%%T.%%N)"

[Install]
WantedBy=multi-user.target
